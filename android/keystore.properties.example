# Copy to a private location (never into git) and fill in the values.
# Point the build at it with:
#   export CHRONO_KEYSTORE_PROPERTIES=/path/to/keystore.properties
# or place it at android/keystore.properties (gitignored).
storeFile=/absolute/path/to/chrono-custom-release.jks
storePassword=
keyAlias=
keyPassword=
